# Postgres connection string (matches docker-compose.yml at the repo root)
DATABASE_URL="postgresql://nutrition:nutrition@localhost:5432/nutrition"

# Long random secret used to sign auth JWTs — generate with `openssl rand -hex 32`
JWT_SECRET="replace-me"

# Server-side only — never shipped to the mobile app. Powers the four AI
# proxy routes (food photo, build photo, food lookup, technique video).
ANTHROPIC_API_KEY="sk-ant-..."

# Expo push notification service needs no secret for basic sends, but set
# this if you enable receipt verification / access tokens later.
EXPO_ACCESS_TOKEN=""

# RevenueCat webhook shared secret (validates the Authorization header RC sends)
REVENUECAT_WEBHOOK_SECRET="replace-me"

PORT=4000
