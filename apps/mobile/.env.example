# Points the app at the backend. Override per environment (simulator vs
# device vs staging/prod) — see src/api/client.ts for how this is read.
#
# The default (localhost) only works in an iOS Simulator (it shares the
# host's network). Everywhere else "localhost" means the device itself, not
# your computer, so the backend will look unreachable even though it's
# running fine:
#   - Physical device via Expo Go: use your computer's LAN IP, e.g.
#     "http://192.168.1.23:4000" (find it with `ipconfig getifaddr en0` on
#     macOS or `hostname -I` on Linux) — phone and computer must be on the
#     same Wi-Fi, and the backend already binds 0.0.0.0 so this works as-is.
#   - Android Emulator: "http://10.0.2.2:4000" (its alias for the host).
EXPO_PUBLIC_API_URL="http://localhost:4000"

# Public RevenueCat SDK keys (safe to ship in the client) — one per store.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=""
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=""

# Must match the entitlement identifier configured in the RevenueCat
# dashboard (Entitlements > identifier) — see src/services/subscriptions.ts.
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID="Healthapp Pro"

# AdMob ad unit IDs — use Google's test IDs during development.
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID="ca-app-pub-3940256099942544/6300978111"

# AdMob *App* IDs (not ad unit IDs) — native, build-time values consumed by
# app.config.js's react-native-google-mobile-ads plugin config at
# `expo prebuild`, so these are read directly from process.env (no
# EXPO_PUBLIC_ prefix, and setting them in .env.local has no effect unless
# you re-run prebuild / a native build). Defaults to Google's test App IDs.
ADMOB_IOS_APP_ID=""
ADMOB_ANDROID_APP_ID=""
