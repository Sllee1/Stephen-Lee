{
  "expo": {
    "name": "Nutrition Tracker",
    "slug": "nutrition-tracker",
    "scheme": "nutritiontracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF9F4"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nutritiontracker.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to photograph meals for nutrition analysis and to log a build photo for a BMI estimate.",
        "NSPhotoLibraryUsageDescription": "Used to pick meal, build, or technique-check photos/videos from your library."
      }
    },
    "android": {
      "package": "com.nutritiontracker.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FBF9F4"
      },
      "permissions": ["CAMERA", "READ_EXTERNAL_STORAGE"]
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#B5502D"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
